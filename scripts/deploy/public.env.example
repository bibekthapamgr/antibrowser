# Public addresses of a staging or production server (R6, ADR-0025). vps-setup.sh copies this file to
# /etc/project-browser/public.env the first time it runs with PB_ENV=staging or PB_ENV=prod. That copy is YOURS:
# fill it in on the server (e.g. with nano), then run vps-setup.sh again. It is never overwritten.
#
# Before you fill it in: create these four DNS records (type A, and AAAA if the server has IPv6) at your domain's
# DNS provider, each pointing at THIS server's public IP address. Use different names for staging and production
# (for example browser.example.com for prod and staging.browser.example.com for staging).
#
# The website, the customer portal (/app/) and the API (/v1/) that the desktop app uses.
SITE_HOST=
# The staff console (/console/). Only staff sign in here (password + one-time code).
ADMIN_HOST=
# Sign-in (Keycloak). Its administration pages are not served on this address.
ID_HOST=
# Encrypted profile snapshots (the storage's upload/download links). Only the snapshot bucket is served.
FILES_HOST=
# Where the certificate authority (Let's Encrypt / ZeroSSL) may write about your certificates (expiry problems).
ACME_EMAIL=
#
# Testing only, never for customers: TLS_MODE=internal makes certificates from a private authority on this server
# instead of a public one (the automated tests use it). The preflight report fails a server that uses it.
TLS_MODE=public
