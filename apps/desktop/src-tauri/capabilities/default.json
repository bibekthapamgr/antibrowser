{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The only capability. The bundled manager window may call the app's own validated commands and listen to its events. No filesystem, shell, HTTP, dialog, opener or remote-URL permission is granted to the webview: native dialogs and link opening happen in Rust after validation.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-state",
    "allow-create-workspace",
    "allow-set-active-workspace",
    "allow-list-profiles",
    "allow-create-profile",
    "allow-update-profile",
    "allow-launch-profile",
    "allow-stop-profile",
    "allow-close-all-profiles",
    "allow-get-runtime-status",
    "allow-select-download-directory",
    "allow-update-setting",
    "allow-get-diagnostics",
    "allow-export-diagnostics",
    "allow-report-ui-ready",
    "allow-recovery-action",
    "allow-resolve-quit",
    "allow-open-external",
    "allow-remove-local-data",
    "allow-get-profile-status",
    "allow-recover-profile",
    "allow-install-runtime",
    "allow-select-profile-download-directory",
    "allow-query-profiles",
    "allow-get-library",
    "allow-create-client",
    "allow-update-client",
    "allow-create-tag",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-save-filter",
    "allow-delete-filter",
    "allow-save-template",
    "allow-delete-template",
    "allow-duplicate-profile",
    "allow-bulk-profiles",
    "allow-undo-action",
    "allow-delete-profiles",
    "allow-choose-import-file",
    "allow-preview-import",
    "allow-commit-import",
    "allow-cancel-import",
    "allow-list-imports",
    "allow-export-profiles",
    "allow-list-proxies",
    "allow-create-proxy",
    "allow-update-proxy",
    "allow-delete-proxy",
    "allow-test-proxy",
    "allow-list-proxy-checks",
    "allow-assign-proxy",
    "allow-validate-privacy",
    "allow-get-privacy-options"
  ]
}
