{
  "name": "@pb/worker",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Outbox worker and snapshot jobs: durable, idempotent background processing on PostgreSQL (no broker yet).",
  "scripts": {
    "dev": "node --env-file=../../infra/env/dev.env.example src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pb/api": "workspace:*",
    "@pb/config": "workspace:*",
    "@pb/contracts": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
