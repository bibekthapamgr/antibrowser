{
  "name": "@pb/api",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fixtures": "./src/fixtures.ts",
    "./migrate": "./scripts/migrate.ts",
    "./seed": "./scripts/seed.ts",
    "./backup/jobs": "./src/backup/jobs.ts",
    "./backup/keys": "./src/backup/keys.ts",
    "./backup/objects": "./src/backup/objects.ts",
    "./webhooks/signing": "./src/webhooks/signing.ts",
    "./automation": "./src/automation.ts",
    "./billing/reconcile": "./src/billing/reconcile.ts",
    "./billing/stripe": "./src/billing/stripe.ts",
    "./email": "./src/email.ts"
  },
  "description": "Control-plane API (Fastify modular monolith): identity, organizations, authorization, leases and snapshots.",
  "scripts": {
    "dev": "node --env-file=../../infra/env/dev.env.example --watch src/server.ts",
    "start": "node src/server.ts",
    "db:migrate": "node --env-file=../../infra/env/dev.env.example scripts/migrate.ts",
    "db:seed": "node --env-file=../../infra/env/dev.env.example scripts/seed.ts",
    "db:reset": "node --env-file=../../infra/env/dev.env.example scripts/migrate.ts --reset && node --env-file=../../infra/env/dev.env.example scripts/seed.ts",
    "openapi": "node --env-file=../../infra/env/dev.env.example scripts/openapi.ts",
    "dev-token": "node --env-file=../../infra/env/dev.env.example scripts/dev-token.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/type-provider-typebox": "6.2.0",
    "@pb/config": "workspace:*",
    "@pb/contracts": "workspace:*",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
