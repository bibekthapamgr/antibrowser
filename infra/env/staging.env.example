# Staging. Values are injected from the secret manager at deploy time; nothing real is committed.
# packages/config refuses to start if dev auth, a fixture secret, a localhost DB or a non "-staging" bucket is used.
APP_ENV=staging
LOG_LEVEL=info
DATABASE_URL=<from secret manager: staging pb_app role>
WORKER_DATABASE_URL=<from secret manager: staging pb_worker role>
MIGRATION_DATABASE_URL=<from secret manager: staging pb_owner role, migration job only>
OIDC_ISSUER=<staging OIDC tenant issuer URL>
OIDC_CLIENT_ID=<staging desktop client id (public client, PKCE)>
OIDC_REDIRECT_URI=projectbrowser://auth/callback
SESSION_ISSUER=pb-api-staging
SESSION_SIGNING_KEY=<from secret manager: staging P-256 private JWK for API session tokens>
SESSION_PREVIOUS_PUBLIC_KEYS=<optional: JSON array of retired public JWKs during key rotation>
TRUST_PROXY_HOPS=1
OBJECT_STORE_ENDPOINT=<staging S3-compatible endpoint>
OBJECT_STORE_BUCKET=pb-snapshots-staging
OBJECT_STORE_REGION=<primary region>
