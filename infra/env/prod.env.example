# Production. Separate cloud account/project, OIDC tenant, database and bucket from staging.
APP_ENV=prod
LOG_LEVEL=info
DATABASE_URL=<from secret manager: prod pb_app role>
WORKER_DATABASE_URL=<from secret manager: prod pb_worker role>
MIGRATION_DATABASE_URL=<from secret manager: prod pb_owner role, migration job only>
OIDC_ISSUER=<prod OIDC tenant issuer URL>
OIDC_CLIENT_ID=<prod desktop client id (public client, PKCE)>
OIDC_REDIRECT_URI=projectbrowser://auth/callback
SESSION_ISSUER=pb-api-prod
SESSION_SIGNING_KEY=<from secret manager: prod P-256 private JWK for API session tokens>
SESSION_PREVIOUS_PUBLIC_KEYS=<optional: JSON array of retired public JWKs during key rotation>
TRUST_PROXY_HOPS=1
OBJECT_STORE_ENDPOINT=<prod S3-compatible endpoint>
OBJECT_STORE_BUCKET=pb-snapshots-prod
OBJECT_STORE_REGION=<primary region>
