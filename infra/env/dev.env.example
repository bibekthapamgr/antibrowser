# Local development. Every value here is a FIXTURE: safe to commit, refused outside dev/test by packages/config.
APP_ENV=dev
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://pb_app:pb_app_dev@127.0.0.1:5432/pb_dev
WORKER_DATABASE_URL=postgres://pb_worker:pb_worker_dev@127.0.0.1:5432/pb_dev
MIGRATION_DATABASE_URL=postgres://pb_owner:pb_owner_dev@127.0.0.1:5432/pb_dev
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=dev-only-insecure-fixture-secret-change-me
# S3-compatible storage (SeaweedFS locally and in CI; fixture credentials).
OBJECT_STORE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORE_BUCKET=pb-snapshots-dev
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=pb-local
OBJECT_STORE_SECRET_ACCESS_KEY=pb-local-fixture-secret-key
OBJECT_STORE_FORCE_PATH_STYLE=true
# Root key of the local key provider (fixture; refused outside dev/test).
KMS_LOCAL_KEYS={"active":"dev-root-1","keys":{"dev-root-1":"ZGV2LW9ubHktaW5zZWN1cmUtcm9vdC1rZXktMzJieXQ="}}
